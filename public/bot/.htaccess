# Skrip bot Turnitin disajikan sebagai JavaScript ber-UTF-8.
#
# Bawaan server menyajikannya sebagai "application/x-javascript" TANPA charset,
# sehingga tanda pisah pada nama skrip tampil rusak ("Phoenix â€" Bot Turnitin")
# dan sebagian pemasang userscript menolak menanganinya.
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddCharset UTF-8 .js
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.user\.js$">
        Header set Content-Type "application/javascript; charset=UTF-8"
        # Pemasang userscript membaca berkas ini langsung. Cache peramban membuat
        # versi lama terus tampil sesudah skripnya diperbarui — jangan disimpan.
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>
