APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# kebutuhan api pelamar
ALLOWED_ORIGIN=http://localhost:5174
MAX_UPLOAD_MB=2
# midtrans
MIDTRANS_SERVER_KEY=your_server_key
MIDTRANS_CLIENT_KEY=your_client_key
MIDTRANS_IS_PRODUCTION=false

# kebutuhan wsl docker
UID=
GID=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Log dipecah per HARI & dibuang otomatis setelah LOG_DAILY_DAYS,
# supaya tidak menumpuk jadi satu berkas raksasa.
# Di PRODUKSI pakai LOG_LEVEL=error (debug mencatat setiap query & terlalu ramai).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# QRIS Dinamis (qris.online / OkeConnect)
QRIS_BASE_URL=https://qris.interactive.co.id/restapi/qris
QRIS_MID=
QRIS_NMID=
QRIS_APIKEY=
QRIS_EXPIRY_MINUTES=30



# Web Push (VAPID) untuk notifikasi PWA — generate dgn: php artisan tinker > Minishlink\WebPush\VAPID::createVapidKeys()
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@lemon.app


# Token pemicu cron cadangan via HTTP (route /cron/run/{token}). Kosong = nonaktif.
CRON_TOKEN=

# --- Bot Telegram (agen operasional admin) ---
# Panduan lengkap: TELEGRAM-AGENT.md
# Kosongkan TELEGRAM_BOT_TOKEN untuk mematikan bot sepenuhnya (webhook -> 404).
TELEGRAM_BOT_TOKEN=
# Wajib. Buat acak: php -r "echo bin2hex(random_bytes(24)).PHP_EOL;"
TELEGRAM_WEBHOOK_SECRET=
# Chat ID yang boleh memerintah, dipisah koma. Kosong = mode pendaftaran.
TELEGRAM_ALLOWED_CHAT_IDS=

# Lapisan AI OPSIONAL. Kosong = bot jalan penuh lewat perintah slash, tanpa biaya.
# driver: openai (9Router/OpenRouter/endpoint OpenAI-compatible) atau anthropic
TELEGRAM_AI_DRIVER=openai
TELEGRAM_AI_BASE_URL=
TELEGRAM_AI_API_KEY=
TELEGRAM_AI_MODEL=

# --- Meta Pixel / Conversions API ---
# Pixel di browser mengirim ViewContent/AddToCart/InitiateCheckout.
# PEMBELIAN dikirim dari server, karena pesanan baru lunas setelah Midtrans/QRIS
# mengonfirmasi — saat itu browser pembeli sering sudah ditutup.
META_PIXEL_ID=
# Kosongkan di mesin lokal: tanpa token, pengiriman ke Facebook mati total
# sehingga menguji checkout tidak mengotori laporan iklan produksi.
META_CAPI_TOKEN=
# Isi HANYA saat menguji di layar "Peristiwa Pengujian" Meta, lalu kosongkan
# lagi. Selama terisi, peristiwa TIDAK masuk laporan iklan.
META_TEST_EVENT_CODE=

# Verifikasi Google Search Console properti "Awalan URL" (meta tag).
# Biarkan KOSONG bila propertinya bertipe "Domain" — yang itu diverifikasi
# lewat catatan TXT di DNS, bukan lewat meta tag.
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4. Kosongkan untuk mematikan pelacakan sepenuhnya.
GA_MEASUREMENT_ID=

# Orcha Journey — dashboard Orcha di dalam lemon (satu akun untuk admin).
# Kuncinya harus SAMA PERSIS dengan ORCHA_API_KEY di aplikasi Orcha.
# Buat kuncinya di sisi Orcha: php artisan orcha:kunci-api --tulis
ORCHA_API_URL=https://orchajourney.com/api/v1
ORCHA_API_KEY=
ORCHA_API_TIMEOUT=10
